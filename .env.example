# ─── Supabase ────────────────────────────────────────────────────────────
# From https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
# New-style "publishable" key (sb_publishable_…)   replaces the legacy anon key.
# Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# New-style "secret" key (sb_secret_…)   replaces service_role. Server-only,
# NEVER prefix with NEXT_PUBLIC_. Bypasses RLS; treat as a master credential.
SUPABASE_SERVER_ROLE_KEY=

# ─── Paystack ────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ─── Identity verification (Smile ID or Dojah   pick one) ────────────────
VERIFICATION_PROVIDER=             # "smile_id" | "dojah"
VERIFICATION_API_KEY=
VERIFICATION_WEBHOOK_SECRET=

# ─── Resend (auth emails via the Supabase Send Email Hook) ───────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified Resend sender, e.g. "Sync <no-reply@yourdomain.com>"
EMAIL_FROM=
# Supabase Dashboard → Authentication → Hooks → Send Email Hook signing secret
# (looks like "v1,whsec_…"). Used to verify the hook request in
# src/app/api/auth/send-email.
SEND_EMAIL_HOOK_SECRET=

# ─── Cron ────────────────────────────────────────────────────────────────
# Bearer secret for scheduled routes (e.g. /api/cron/purge-archived, which
# permanently deletes accounts archived >60 days). Vercel Cron sends this.
CRON_SECRET=

# ─── Upstash Redis (rate limiting) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Google Maps ─────────────────────────────────────────────────────────
# The /around map. Both are NEXT_PUBLIC_ by necessity - the Maps JS API runs in
# the browser - so restrict the key by HTTP referrer in the Cloud console.
#
# In the Google Cloud console the project needs, at minimum:
#   1. "Maps JavaScript API" ENABLED (an un-enabled API is what produces the
#      grey map + "This page can't load Google Maps correctly" dialog),
#   2. billing enabled on the project,
#   3. every origin you load from in the key's HTTP-referrer allowlist -
#      including the LAN IP (http://192.168.x.x:3000) if you test on a phone.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID from Cloud console → Map Management. REQUIRED in production: Advanced
# Markers (every pin we draw) do not render without one. Development falls back
# to Google's rate-limited DEMO_MAP_ID so the map works before you make one.
NEXT_PUBLIC_GOOGLE_MAPS_ID=
